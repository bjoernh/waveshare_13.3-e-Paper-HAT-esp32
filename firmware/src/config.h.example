#ifndef CONFIG_H
#define CONFIG_H

// WiFi Configuration
// Copy this file to config.h and update with your network credentials
#define WIFI_SSID "YOUR_WIFI_SSID"
#define WIFI_PASSWORD "YOUR_WIFI_PASSWORD"

// Image Server Configuration
// NOTE: These are now configurable at runtime via the web interface!
// These values are only used as initial defaults on first boot.
// To change the server, hold the user button (D2) during boot to enter config mode.
//
// Default values are defined in config_manager.h:
//   DEFAULT_SERVER_HOST "192.168.86.100"
//   DEFAULT_SERVER_PORT 8000
//   DEFAULT_IMAGE_ENDPOINT "/image_packed"
//   DEFAULT_SLEEP_MINUTES 15

// Display Pin Configuration
// Waveshare 13.3" e-Paper HAT+ (E) wired to a Waveshare ESP32-S3-Nano.
// Pin names use the Arduino Nano D/A macros so the code works whether the
// Arduino core is in "By Arduino pin" or "By GPIO number" mode.
#define PIN_SPI_CLK     D13   // SCK  (HAT+ CLK)
#define PIN_SPI_MOSI    D11   // MOSI (HAT+ DIN)
#define PIN_CS_MASTER   D10   // HAT+ CS_M (master controller chip select)
#define PIN_CS_SLAVE    D9    // HAT+ CS_S (slave controller chip select)
#define PIN_DC          D8    // Data / Command
#define PIN_RESET       D7
#define PIN_BUSY        D6    // LOW = busy, HIGH = idle
#define PIN_POWER       D5    // HAT+ PWR (HIGH = enable, LOW = power-gate panel)

// User button: momentary switch from D2 to GND (uses internal pull-up).
// Hold during boot for 1 second to enter the web configuration mode.
#define PIN_BUTTON_1    D2

// Optional external battery voltage divider.
// The ESP32-S3-Nano has no on-board divider; uncomment BATTERY_MONITOR_ENABLED
// and wire your own divider (Vbat -> R1 -> A0 -> R2 -> GND) if you want to
// report battery voltage to the server via the X-Battery-Voltage header.
// Calibrate BATTERY_SCALE = (R1 + R2) / R2 for your resistor values.
// #define BATTERY_MONITOR_ENABLED  1
#define PIN_BATTERY_ADC   A0
#define PIN_ADC_ENABLE    A1
#define BATTERY_SCALE     2.0f

// Display Dimensions
#define DISPLAY_WIDTH   1600
#define DISPLAY_HEIGHT  1200
#define BUFFER_SIZE     960000  // (1600 * 1200) / 2 bytes (4bpp)

// HTTP timeout for control requests like /hash and /device_config (in milliseconds)
#define HTTP_TIMEOUT_MS 30000

// How long to wait for /image_packed to start responding (in milliseconds).
// The server may need extra time to process the next image before it can start
// streaming the 960KB body. Keep this <= 65535 because HTTPClient::setTimeout()
// takes a 16-bit millisecond value in this environment.
#define IMAGE_INITIAL_RESPONSE_TIMEOUT_MS 60000

// How long to tolerate no incoming image bytes once the transfer is underway.
#define IMAGE_STALL_TIMEOUT_MS 20000

// WiFi connection timeout (in milliseconds)
#define WIFI_TIMEOUT_MS 30000

// Static IP configuration (optional).
// Assigning a fixed IP skips DHCP negotiation on every wake from deep sleep,
// which saves ~200-500 ms and a few mA of radio time per boot cycle.
// Comment out STATIC_IP to fall back to DHCP.
// #define STATIC_IP       "192.168.x.y"
// #define STATIC_GATEWAY  "192.168.x.1"
// #define STATIC_SUBNET   "255.255.255.0"
// #define STATIC_DNS1     "192.168.x.1"

// Development: simulated display mode
// When enabled, all SPI/GPIO/refresh operations are skipped so the panel is
// not stressed during debugging sessions.  The image buffer is still allocated
// and populated normally, so all download/processing logic can be tested.
// Enable via platformio.ini build_flags instead of editing this file:
//   -DSIM_DISPLAY

#endif // CONFIG_H
